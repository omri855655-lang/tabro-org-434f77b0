# Public browser configuration: set only after identifying your own target project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Server-only secrets belong in Supabase secrets, never VITE_ variables or Git:
# GEMINI_API_KEY
# GEMINI_FLASH_MODEL (optional)
# GEMINI_PRO_MODEL (optional)
# AI_ENABLED=true
# AI_MAX_OUTPUT_TOKENS=8192
# RESEND_API_KEY_1
